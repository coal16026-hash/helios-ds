# Server-side only. The frontend never contains keys; they live here / in Render env vars.
GOOGLE_KEYS=
UNOROUTER_KEYS=
OPENROUTER_KEYS=
AGNES_KEYS=

# OAuth (sign in with Google / GitHub / Discord).
# Callback URL to register: https://helios-frontend-zeta.vercel.app/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional
PORT=8787
CORS_ORIGIN=*
# Comma-separated lists are allowed, e.g. GOOGLE_KEYS=key1,key2
# Override the model routing with JSON:
# ROUTES_JSON={"helium":[["google","gemini-3.1-flash-lite"]],"carbon":[["google","gemini-4-argon"]]}